# TABLESERVE Environment Blueprint

# Server Ports
PORT_GATEWAY=5000
PORT_RESTAURANT=5001
PORT_RESERVATION=5002
PORT_ORDERING=5003
PORT_SEARCH=5004
PORT_FRONTEND=3000

# Security
JWT_SECRET=tableserve-super-secret-jwt-key-2026
JWT_EXPIRES_IN=24h

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgrespassword@localhost:5432/tableserve
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgrespassword
PGDATABASE=tableserve

# Downstream Microservices URLs
RESTAURANT_SERVICE_URL=http://localhost:5001
RESERVATION_SERVICE_URL=http://localhost:5002
ORDERING_SERVICE_URL=http://localhost:5003
SEARCH_SERVICE_URL=http://localhost:5004
GATEWAY_URL=http://localhost:5000

# AWS Cloud Integration (Optional for local development)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:tableserve-reservations-topic
AWS_LEX_BOT_ID=
AWS_LEX_BOT_ALIAS_ID=
AWS_S3_BUCKET_NAME=tableserve-media-assets
