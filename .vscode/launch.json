{
  "version": "0.2.0",
  "configurations": [
    {
      "type": "node",
      "request": "launch",
      "name": "🚀 Launch TABLESERVE Stack (All Services + Frontend)",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/start-all.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "NODE_ENV": "development",
        "PATH": "C:\\Program Files\\nodejs;${env:PATH}"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "🧪 Run End-to-End API Tests",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/tests/api-tests.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PATH": "C:\\Program Files\\nodejs;${env:PATH}"
      }
    },
    {
      "type": "node",
      "request": "launch",
      "name": "🌱 Run Database Seeder",
      "skipFiles": ["<node_internals>/**"],
      "program": "${workspaceFolder}/database/seeder.js",
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {
        "PATH": "C:\\Program Files\\nodejs;${env:PATH}"
      }
    }
  ]
}
